# Development-only defaults. Optional root .env overrides these; shell wins.
# Plain dotenv values: no shell execution or ${VAR} expansion.
# Leave derived settings commented to calculate them from the effective ports.

# Defaults to a checkout-path hash. Set explicitly to retain a namespace on move.
# UMBRA_PROJECT_NAME=my-product-dev
DEV_BIND_HOST=127.0.0.1

POSTGRES_PORT=54329
POSTGRES_USER=umbra
POSTGRES_PASSWORD=umbra_dev_only
POSTGRES_DB=umbra
# DATABASE_URL=postgresql://umbra:umbra_dev_only@127.0.0.1:54329/umbra

MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=umbra_dev
MINIO_ROOT_PASSWORD=umbra_dev_only_password
S3_BUCKET=umbra-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT=http://127.0.0.1:19000
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
# S3_ACCESS_KEY_ID=umbra_dev
# S3_SECRET_ACCESS_KEY=umbra_dev_only_password

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_HOST=127.0.0.1
APP_PORT=5173
SITE_HOST=127.0.0.1
SITE_PORT=4321
RUST_LOG=info,umbra_server=debug

# Public values: safe for frontend bundles. Hostname must be client-reachable.
# PUBLIC_API_URL=http://127.0.0.1:8080
# PUBLIC_WS_URL=ws://127.0.0.1:8080/ws
# PUBLIC_APP_URL=http://127.0.0.1:5173
# PUBLIC_SITE_URL=http://127.0.0.1:4321
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4321

# Product-specific server secrets may be added to .env. Do not prefix them PUBLIC_
# or VITE_, and never configure frontend tooling to expose the whole environment.
